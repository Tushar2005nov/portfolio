# Google Forms Configuration
# Instructions:
# 1. Create a form at https://forms.google.com
# 2. Add form fields: Name, Email, Subject, Message
# 3. Get Form ID from URL: https://forms.google.com/u/0/d/{FORM_ID}/edit
# 4. Get Field IDs from form responses or network inspection

# Form ID (from URL)
VITE_GOOGLE_FORM_ID=YOUR_FORM_ID_HERE

# Google Forms submission URL
# Format: https://docs.google.com/forms/d/{FORM_ID}/formResponse
VITE_GOOGLE_FORM_URL=https://docs.google.com/forms/d/YOUR_FORM_ID_HERE/formResponse

# Field IDs (from form inspection)
# To get field IDs: 
# - Open form in browser
# - Inspect network tab
# - Look for entry.XXXXXXXXXX in form submissions
VITE_FORM_FIELD_NAME=entry.1234567890
VITE_FORM_FIELD_EMAIL=entry.0987654321
VITE_FORM_FIELD_SUBJECT=entry.1111111111
VITE_FORM_FIELD_MESSAGE=entry.2222222222

# Optional: If using email service (Emailjs, Formspree, etc.)
VITE_EMAIL_SERVICE_URL=https://api.emailjs.com/api/v1.0/email/send
VITE_EMAIL_SERVICE_KEY=YOUR_KEY_HERE

# Other configuration
VITE_SITE_TITLE=Your Portfolio Name
VITE_SITE_DESCRIPTION=Your portfolio description
